# ─────────────────────────────────────────────────────────────────────────────
# pitft-dashboard .env  –  rename to .env, fill in your keys, never commit this
# ─────────────────────────────────────────────────────────────────────────────

# Anthropic Console Admin Key
# Generate at: console.anthropic.com → Settings → API keys
# Must be a *Console/Admin* key (starts with sk-ant-admin-…), not a regular API key.
ANTHROPIC_ADMIN_KEY=sk-ant-admin-REPLACE_ME

# Claude.ai session cookie
# 1. Log into claude.ai in your browser
# 2. DevTools → Application → Cookies → https://claude.ai
# 3. Copy the VALUE of the __session cookie (long string)
CLAUDE_SESSION_KEY=REPLACE_ME

# ElevenLabs API key
# Generate at: elevenlabs.io → Profile → API Key
ELEVENLABS_API_KEY=REPLACE_ME

# ── Optional tuning ────────────────────────────────────────────────────────────
# Auto-refresh interval in seconds (default: 300 = 5 minutes)
# REFRESH_INTERVAL_SECONDS=300
