# ─────────────────────────────────────────────────────────────────────────────
# pitft-dashboard .env  –  copy to .env, fill in values, never commit .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Anthropic ──────────────────────────────────────────────────────────────────
# Any regular API key — used to verify liveness and read rate-limit headers
# console.anthropic.com → Settings → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-REPLACE_ME

# Credit balance — update manually after topping up at console.anthropic.com
ANTHROPIC_CREDIT_BALANCE=14.23

# Tier shown in the Console (Build, Scale, etc.)
ANTHROPIC_TIER=Build

# ── ElevenLabs ────────────────────────────────────────────────────────────────
# elevenlabs.io → avatar → Profile + API key
ELEVENLABS_API_KEY=REPLACE_ME

# ── Optional ──────────────────────────────────────────────────────────────────
# Auto-refresh interval in seconds (default 300 = 5 minutes)
# REFRESH_INTERVAL_SECONDS=300
